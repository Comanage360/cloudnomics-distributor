# --- Server ---
PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# --- Database (Railway/Render provide this) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudnomics
# Set to "true" on hosted Postgres that requires SSL (Railway/Render/Neon)
PGSSL=false

# --- Anthropic ---
# Optional: if omitted, the firewall recommendation uses a safe local fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01

# --- Pricing rules ---
RESELLER_DISCOUNT=0.30
IMPL_RATE=0.15
MANAGED_RATE=0.15
QUOTE_START=643555

# --- Email (optional; dry-run if unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=quotes@cloudnomics.net
