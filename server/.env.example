# --- Server ---
PORT=4000
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# --- Database (Railway/Render provide this) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudnomics
# Set to "true" on hosted Postgres that requires SSL (Railway/Render/Neon)
PGSSL=false

# --- Anthropic ---
# Optional: if omitted, the firewall recommendation uses a safe local fallback.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01

# --- Pricing rules ---
RESELLER_DISCOUNT=0.30
IMPL_RATE=0.15
MANAGED_RATE=0.15
QUOTE_START=643555

# --- Email ---
# Preferred: SendGrid Web API (works on hosts that block SMTP ports, e.g. Railway).
# Create an API key (Mail Send permission) and verify the FROM_EMAIL sender/domain.
SENDGRID_API_KEY=
FROM_EMAIL=quotes@cloudnomics.net   # MUST be a verified SendGrid sender/domain

# Fallback: raw SMTP (used only if SENDGRID_API_KEY is unset). Dry-run if both unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
